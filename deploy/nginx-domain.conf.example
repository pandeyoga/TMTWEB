# For later, when a domain points to this VPS and nginx already serves other projects on 80/443.
# 1. Copy to /etc/nginx/sites-available/triyasa, replace triyasa.co.id and 8080 (APP_PORT in .env), then:
#    ln -s /etc/nginx/sites-available/triyasa /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
#    certbot --nginx -d triyasa.co.id -d www.triyasa.co.id
# 2. In /opt/triyasa-web/.env set SITE_URL=https://triyasa.co.id and APP_BIND=127.0.0.1, then: docker compose up -d
server {
    listen 80;
    server_name triyasa.co.id www.triyasa.co.id;
    client_max_body_size 30M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
