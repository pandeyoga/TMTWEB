# --- Docker (VPS) ---
# Password for the PostgreSQL container (docker-compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Domain for Caddy. Leave as :80 until a domain points to this server.
SITE_ADDRESS=:80

# --- Local development ---
# Database (PostgreSQL)
DATABASE_URL=postgres://triyasa:PASSWORD@127.0.0.1:5432/triyasa
# Random string, minimum 32 characters
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang
# Used by the CMS live preview
PREVIEW_SECRET=ganti-dengan-string-acak-panjang
# Public URL of the site, read at runtime (no trailing slash). Change when the domain is ready.
SITE_URL=http://localhost:3000
# Folder for uploaded media (default: ./media)
# MEDIA_DIR=/app/media

# Optional: email notification for new leads
# LEAD_NOTIFY_EMAIL=sales@domain-anda.co.id
# SMTP_HOST=smtp.domain-anda.co.id
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@domain-anda.co.id
# SMTP_FROM_NAME=Website Triyasa
